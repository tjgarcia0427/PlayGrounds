[Unit]
Description=PlayGrounds application (reviewed release only)
After=network.target
# Restart policy (issue #33): on-failure with a burst cap so a corrupt
# state file cannot thrash the host — after 5 starts in 5 minutes the
# unit stays down for a human (check /api/health and the ledger).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=playgrounds
Group=playgrounds
WorkingDirectory=/opt/playgrounds/current/mvp
EnvironmentFile=/etc/playgrounds/runtime.env
ExecStart=/usr/bin/python3 /opt/playgrounds/current/mvp/server.py
Restart=on-failure
RestartSec=5
StateDirectory=playgrounds
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/playgrounds
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
